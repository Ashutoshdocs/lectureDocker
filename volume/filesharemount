# 1. Create a directory on the Docker host for the mounted file share
mkdir -p /mnt/fileshare

# 2. Verify the directory
ls -ld /mnt/fileshare

# 3. Mount your Azure File Share on the Docker host
# Replace <STORAGE_ACCOUNT>, <FILE_SHARE>, and <STORAGE_KEY>
mount -t cifs //<STORAGE_ACCOUNT>.file.core.windows.net/<FILE_SHARE> \
  /mnt/fileshare \
  -o vers=3.0,username=<STORAGE_ACCOUNT>,password=<STORAGE_KEY>,dir_mode=0777,file_mode=0777,serverino

# 4. Verify that the file share is mounted
df -h /mnt/fileshare

# 5. Verify the mount
mount | grep /mnt/fileshare

# 6. Create index.html directly on the mounted file share
cat > /mnt/fileshare/index.html <<'EOF'
<!DOCTYPE html>
<html>
<head>
    <title>Docker + Azure File Share</title>
</head>
<body>
    <h1>Hello from Azure File Share!</h1>
    <h2>Served by Nginx Container</h2>
    <p>This index.html is stored on the mounted file share.</p>
</body>
</html>
EOF

# 7. Verify index.html exists on the file share
ls -l /mnt/fileshare/index.html

# 8. Verify the contents
cat /mnt/fileshare/index.html

# 9. Pull the Nginx image
docker pull nginx:alpine

# 10. Run Nginx container using the file share
docker run -d \
  --name nginx-fileshare \
  -p 80:80 \
  -v /mnt/fileshare:/usr/share/nginx/html:ro \
  nginx:alpine

# 11. Verify the container is running
docker ps

# 12. Verify the bind mount
docker inspect nginx-fileshare --format '{{json .Mounts}}'

# 13. Verify index.html exists inside the Nginx container
docker exec nginx-fileshare ls -l /usr/share/nginx/html

# 14. Read index.html from inside the container
docker exec nginx-fileshare cat /usr/share/nginx/html/index.html

# 15. Test Nginx from the Docker host
curl http://localhost

# 16. Test using the VM's IP address
curl http://<VM_PRIVATE_OR_PUBLIC_IP>

# 17. Check Nginx logs
docker logs nginx-fileshare

# 18. Modify index.html directly on the file share
cat > /mnt/fileshare/index.html <<'EOF'
<!DOCTYPE html>
<html>
<head>
    <title>Updated Website</title>
</head>
<body>
    <h1>Updated from Azure File Share!</h1>
    <p>Nginx is serving this file directly from the mounted file share.</p>
</body>
</html>
EOF

# 19. Verify the updated file from inside the container
docker exec nginx-fileshare cat /usr/share/nginx/html/index.html

# 20. Test the updated website
curl http://localhost

# 21. Verify the mount from inside the container
docker exec nginx-fileshare mount | grep /usr/share/nginx/html

# 22. Inspect the complete container mount configuration
docker inspect nginx-fileshare --format '{{json .Mounts}}'

# 23. Stop the container
docker stop nginx-fileshare

# 24. Remove the container
docker rm nginx-fileshare

# 25. Verify index.html still exists on the file share
ls -l /mnt/fileshare/index.html

# 26. Verify the data survived container deletion
cat /mnt/fileshare/index.html

# 27. Unmount the Azure File Share when finished
umount /mnt/fileshare

# 28. Verify it is no longer mounted
df -h /mnt/fileshare
